VITE_API_URL=http://127.0.0.1:8000/api

# --- Suporte (item "Suporte" do menu e tela de login) ------------------------------------------
# Portal onde o cliente abre chamado — abre SEMPRE em aba nova. Vazio = opção não aparece.
VITE_URL_SUPORTE=http://l1-prestor.prossigatec.com.br/authentication/login
# E-mail do suporte (menu e login). Vazio = opção não aparece.
VITE_EMAIL_SUPORTE=suporte@prossigatec.com.br

# --- Docker (docker-compose.yml) --------------------------------------------------------------
# Porta do host pro admin — a VPS já roda outras aplicações, troque se 8080 colidir com alguma.
ADMIN_PORT=8080
